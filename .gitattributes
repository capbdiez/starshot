* text=auto eol=lf

# Art and audio sources live in Git LFS (ARCHITECTURE §6).
art-src/**/*.aseprite filter=lfs diff=lfs merge=lfs -text
art-src/**/*.ase filter=lfs diff=lfs merge=lfs -text
art-src/**/*.wav filter=lfs diff=lfs merge=lfs -text
art-src/**/*.rpp filter=lfs diff=lfs merge=lfs -text
art-src/**/*.mmpz filter=lfs diff=lfs merge=lfs -text

# Exported runtime assets are committed as regular binaries.
*.png binary
*.ogg binary
*.m4a binary
