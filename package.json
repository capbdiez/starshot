{
  "name": "starshot",
  "private": true,
  "version": "1.0.0",
  "description": "Neo-arcade fixed shooter for the web.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:deps": "depcruise src tools --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test",
    "release:archive": "npm run build && node tools/package-itch.ts",
    "check:assets": "node tools/check-assets.ts",
    "assets:export": "node tools/export-aseprite.ts",
    "assets:atlas": "node tools/build-atlas.ts",
    "assets:sfx": "node tools/build-sfx.ts",
    "assets:music": "node tools/build-music.ts",
    "assets:art": "node tools/build-art.ts",
    "assets:build": "npm run assets:export && npm run assets:art && npm run assets:atlas && npm run assets:sfx && npm run assets:music && npm run check:assets"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/pngjs": "6.0.5",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
